class Student {
    int rollNo;
    String name;

    Student(int r, String n) {
        rollNo = r;
        name = n;
    }

    void display() {
        System.out.println(rollNo + "-" + name);
    }
}

public class Main {
    public static void main(String[] args) {

        Student s1 = new Student(120, "Aman");
        s1.display();
    }
}
